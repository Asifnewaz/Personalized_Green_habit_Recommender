# =====================================================================
# .gitignore — Green Habit Recommender
# Covers: macOS, Windows, Linux, IDEs, JavaScript/Node.js, Swift/Xcode,
#         MongoDB, MySQL, R, Python / Machine Learning, secrets
# =====================================================================


# ---------------------------------------------------------------------
# Secrets & environment (never commit these)
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.cer
*.mobileprovision
secrets/
credentials.json
service-account*.json
config/local.*


# ---------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk


# ---------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk


# ---------------------------------------------------------------------
# Linux
# ---------------------------------------------------------------------
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# ---------------------------------------------------------------------
# Editors & IDEs
# ---------------------------------------------------------------------
# VS Code (keep shared settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains (WebStorm, IntelliJ, PyCharm, DataGrip)
.idea/
*.iml
*.iws
out/

# Vim / Emacs / Sublime
*.swp
*.swo
*.un~
Session.vim
\#*\#
.\#*
*.sublime-workspace


# ---------------------------------------------------------------------
# JavaScript / Node.js
# ---------------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager caches
.npm/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.pnpm-store/

# Build output
dist/
build/
.next/
.nuxt/
.output/
.svelte-kit/
.angular/
.vite/
.parcel-cache/
.turbo/
.vercel/
.netlify/
.serverless/
*.tsbuildinfo

# Testing & coverage
coverage/
.nyc_output/
*.lcov
junit.xml
playwright-report/
test-results/

# Runtime
pids/
*.pid
*.seed
*.pid.lock
.cache/
.eslintcache
.stylelintcache


# ---------------------------------------------------------------------
# Swift / Xcode / iOS
# ---------------------------------------------------------------------
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.pins
Package.resolved.bak

# CocoaPods / Carthage
Pods/
Carthage/Build/
Carthage/Checkouts/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/


# ---------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------
# Local data directories and dumps
data/db/
mongo-data/
mongodb-data/
dump/
*.bson
mongod.lock
mongod.log
*.wt
WiredTiger*


# ---------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------
# Local data directory and dumps
# (schema and migration .sql files are NOT ignored on purpose)
mysql-data/
mysql/data/
*.sql.gz
*.sql.zip
*dump*.sql
backup*.sql
*.ibd
*.frm
*.myd
*.myi
ib_logfile*
ibdata*
mysql-bin.*
*.err


# ---------------------------------------------------------------------
# Docker (local volumes only; keep Dockerfile & compose files)
# ---------------------------------------------------------------------
docker-volumes/
.docker-data/
docker-compose.override.yml


# ---------------------------------------------------------------------
# R / RStudio
# ---------------------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Rapp.history
*.Rproj.user
*-Ex.R
*.tar.gz
*.Rcheck/
.Rcache/
rsconnect/
*_cache/
/cache/
*.utf8.md
*.knit.md
vignettes/*.html
vignettes/*.pdf

# renv (keep renv.lock and renv/activate.R)
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# Shiny
shiny_bookmarks/


# ---------------------------------------------------------------------
# Python (used for ML / data work)
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/
.installed.cfg

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/
conda-env/
__pypackages__/

# Tools
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.pyre/
.pytype/


# ---------------------------------------------------------------------
# Machine Learning & Data Science
# ---------------------------------------------------------------------
# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# Large / raw data (commit small samples to data/sample/ instead)
data/raw/
data/interim/
data/processed/
data/external/
!data/sample/
*.parquet
*.feather
*.h5
*.hdf5
*.npy
*.npz
*.tfrecord
*.arrow

# Trained models & checkpoints
models/*
!models/.gitkeep
checkpoints/
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.ckpt
*.onnx
*.pb
*.tflite
*.mlmodel
*.mlpackage
*.safetensors
*.keras
*.rds

# Experiment tracking
mlruns/
mlartifacts/
wandb/
runs/
lightning_logs/
tensorboard/
outputs/
multirun/
.dvc/cache/
.dvc/tmp/

# Hugging Face cache
.huggingface/
hf_cache/


# ---------------------------------------------------------------------
# SMARD / generated data for this project
# ---------------------------------------------------------------------
smard_cache/
data/smard/raw/
data/synthetic/generated/


# ---------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
*.zip
*.7z
*.rar